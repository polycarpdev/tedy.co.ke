---
// src/components/Tedy.astro
import '../styles/tedy.css';
---
<svg class="tedy" data-tedy data-outfit="jersey" data-acc="none" viewBox="0 0 120 216" aria-hidden="true">
  <defs>
    <pattern id="camo" width="24" height="24" patternUnits="userSpaceOnUse">
      <rect width="24" height="24" fill="#6d6248" />
      <path d="M0 4 Q6 0 10 5 T20 6 L18 11 Q10 13 4 10 Z" fill="#4f5d34" />
      <path d="M2 15 Q8 12 12 17 Q8 22 3 20 Z" fill="#5a3f2e" />
      <path d="M14 14 Q20 12 24 16 L23 22 Q17 23 14 19 Z" fill="#3b3428" />
    </pattern>
  </defs>

  <g class="seat">
    <rect x="38" y="160" width="34" height="54" rx="6" fill="#4a3322" />
    <ellipse cx="55" cy="161" rx="17" ry="4" fill="#6b4a31" />
  </g>

  <g class="part body">
    <g class="arm-back">
      <g class="part upper">
        <line class="s-skin" x1="52" y1="57" x2="52" y2="86" stroke-width="9" />
        <line class="o o-jersey s-jersey" x1="52" y1="56" x2="52" y2="70" stroke-width="12.5" />
        <line class="o o-casual s-tee" x1="52" y1="56" x2="52" y2="70" stroke-width="12.5" />
        <line class="o o-army s-camo" x1="52" y1="56" x2="52" y2="82" stroke-width="12.5" />
        <g class="part fore">
          <line class="s-skin" x1="52" y1="86" x2="52" y2="113" stroke-width="8" />
          <circle class="c-skin" cx="52" cy="116" r="4.6" />
        </g>
      </g>
    </g>

    <g class="leg-back">
      <g class="part thigh">
        <line class="s-skin" x1="55" y1="104" x2="55" y2="156" stroke-width="11" />
        <line class="o o-jersey s-shorts" x1="55" y1="102" x2="55" y2="126" stroke-width="15" />
        <line class="o o-army s-camo" x1="55" y1="102" x2="55" y2="156" stroke-width="13" />
        <line class="o o-casual s-jeans" x1="55" y1="102" x2="55" y2="156" stroke-width="13" />
        <g class="part shin">
          <line class="s-skin" x1="55" y1="156" x2="55" y2="203" stroke-width="10" />
          <line class="o o-jersey s-sock" x1="55" y1="176" x2="55" y2="201" stroke-width="11" />
          <path class="o o-jersey c-boot" d="M49 204 L49 199 L61 199 Q70 201 70 208 L70 212 L49 212 Z" />
          <line class="o o-army s-camo" x1="55" y1="156" x2="55" y2="190" stroke-width="13" />
          <rect class="o o-army c-boot" x="49" y="186" width="12" height="20" rx="2" />
          <path class="o o-army c-boot" d="M49 204 L49 199 L61 199 Q70 201 70 208 L70 212 L49 212 Z" />
          <line class="o o-casual s-jeans" x1="55" y1="156" x2="55" y2="200" stroke-width="12.5" />
          <path class="o o-casual c-sneaker" d="M49 204 Q49 199 55 199 L62 201 Q71 202.5 71 208.5 L71 210 L49 210 Z" />
          <rect class="o o-casual c-sole" x="48.5" y="209.5" width="23" height="4" rx="2" />
          <rect class="o o-casual" x="52" y="210.3" width="6" height="2.4" rx="1.2" fill="#9ad0e6" />
          <path class="o o-casual" d="M56 206 Q62 207.5 68 203.5" stroke="#da291c" stroke-width="1.6" fill="none" />
        </g>
      </g>
    </g>

    <rect class="o o-jersey c-shorts" x="49" y="97" width="21" height="16" rx="5" />
    <rect class="o o-army c-camo" x="49" y="97" width="21" height="16" rx="5" />
    <rect class="o o-casual c-jeans" x="49" y="97" width="21" height="16" rx="5" />

    <g class="leg-front">
      <g class="part thigh">
        <line class="s-skin" x1="63" y1="104" x2="63" y2="156" stroke-width="11" />
        <line class="o o-jersey s-shorts" x1="63" y1="102" x2="63" y2="126" stroke-width="15" />
        <line class="o o-army s-camo" x1="63" y1="102" x2="63" y2="156" stroke-width="13" />
        <line class="o o-casual s-jeans" x1="63" y1="102" x2="63" y2="156" stroke-width="13" />
        <g class="part shin">
          <line class="s-skin" x1="63" y1="156" x2="63" y2="203" stroke-width="10" />
          <line class="o o-jersey s-sock" x1="63" y1="176" x2="63" y2="201" stroke-width="11" />
          <path class="o o-jersey c-boot" d="M57 204 L57 199 L69 199 Q78 201 78 208 L78 212 L57 212 Z" />
          <line class="o o-army s-camo" x1="63" y1="156" x2="63" y2="190" stroke-width="13" />
          <rect class="o o-army c-boot" x="57" y="186" width="12" height="20" rx="2" />
          <path class="o o-army c-boot" d="M57 204 L57 199 L69 199 Q78 201 78 208 L78 212 L57 212 Z" />
          <line class="o o-casual s-jeans" x1="63" y1="156" x2="63" y2="200" stroke-width="12.5" />
          <path class="o o-casual c-sneaker" d="M57 204 Q57 199 63 199 L70 201 Q79 202.5 79 208.5 L79 210 L57 210 Z" />
          <rect class="o o-casual c-sole" x="56.5" y="209.5" width="23" height="4" rx="2" />
          <rect class="o o-casual" x="60" y="210.3" width="6" height="2.4" rx="1.2" fill="#9ad0e6" />
          <path class="o o-casual" d="M64 206 Q70 207.5 76 203.5" stroke="#da291c" stroke-width="1.6" fill="none" />
        </g>
      </g>
    </g>

    <g class="torso">
      <path class="o o-jersey c-jersey" d="M49 54 Q61 49 73 54 Q77 57 76.5 62 L74 104 Q61 107 50 104 L47.5 62 Q47 57 49 54 Z" />
      <path class="o o-jersey" d="M55.5 51.5 L61 57 L66.5 51.5" fill="none" stroke="#fff" stroke-width="2" />
      <text class="o o-jersey" x="64" y="86" text-anchor="middle" font-size="18" font-weight="700" font-family="sans-serif" fill="#fff">6</text>
      <path class="o o-casual c-tee" d="M49 54 Q61 49 73 54 Q77 57 76.5 62 L74 104 Q61 107 50 104 L47.5 62 Q47 57 49 54 Z" />
      <path class="o o-casual" d="M56 51.5 Q61 55.5 66 51.5" fill="none" stroke="#cfcac1" stroke-width="1.6" />
      <path class="o o-army c-camo" d="M49 54 Q61 49 73 54 Q77 57 76.5 62 L74 104 Q61 107 50 104 L47.5 62 Q47 57 49 54 Z" />
      <path class="o o-army" d="M55 51 L61 58 L67 51" fill="none" stroke="#3b3428" stroke-width="2" />
      <rect class="o o-army" x="51" y="63" width="9" height="8" rx="1" fill="rgba(0,0,0,0.2)" />
      <rect class="o o-army" x="64" y="63" width="9" height="8" rx="1" fill="rgba(0,0,0,0.2)" />
      <rect class="o o-army c-boot" x="49.5" y="100" width="25" height="4.5" rx="1" />
      <g class="acc acc-camera">
        <path d="M52 54 L72 90" stroke="#1a1a1a" stroke-width="2" fill="none" />
        <rect x="69" y="84" width="5" height="3" rx="1" fill="#1d1d1d" />
        <rect x="66" y="86" width="15" height="11" rx="2.2" fill="#1d1d1d" />
        <circle cx="78" cy="91.5" r="3.7" fill="#0c0c0c" stroke="#555" stroke-width="1" />
      </g>
    </g>

    <g class="part head">
      <path class="c-skin" d="M57 38 L65 38 L65.5 55 L56.5 55 Z" />
      <path class="c-skin" d="M50 29 Q50 14 62 13 Q74 13 74.5 26 L76.5 31 Q76.8 32.5 75 33 L74.6 36 Q74 41 68.5 43.5 Q63 45 57 42 Q51 39 50 29 Z" />
      <ellipse class="c-skin-dark" cx="53" cy="30" rx="2.4" ry="3.6" />
      <ellipse class="o o-jersey" cx="58" cy="18" rx="4" ry="2" fill="#fff" opacity="0.14" />
      <g class="eye">
        <circle class="c-ink" cx="67" cy="26.5" r="1.5" />
        <circle cx="67.5" cy="26" r="0.45" fill="#fff" />
      </g>
      <path d="M64.5 23 Q67.5 21.8 70.5 23" fill="none" stroke="#1a1a1a" stroke-width="1.1" stroke-linecap="round" />
      <path d="M67 35.6 Q70.5 34.4 74 35.6" fill="none" stroke="#111" stroke-width="1.5" stroke-linecap="round" />
      <path d="M68.5 38.6 Q71 39.4 73 38.2" fill="none" stroke="#3a2216" stroke-width="1" stroke-linecap="round" />

      <g class="o o-casual">
        <path class="c-cap" d="M49.5 25 Q49.5 10.5 62 10.5 Q74.5 10.5 75 24.5 Z" />
        <path d="M62 10.8 Q64 17 63.5 24.5" fill="none" stroke="#a81e14" stroke-width="0.8" />
        <path class="c-cap-dark" d="M71 23.2 Q80.5 21.5 86 24.6 Q80 26.4 71 25.8 Z" />
        <circle class="c-cap-dark" cx="62" cy="10.8" r="1.3" />
      </g>
      <g class="o o-army">
        <ellipse class="c-camo" cx="62.5" cy="23" rx="19.5" ry="3.6" />
        <path class="c-camo" d="M51 23 Q51.5 10 62.5 10 Q73.5 10 74 23 Z" />
        <rect x="51.3" y="19.5" width="22.5" height="3" fill="rgba(0,0,0,0.25)" />
      </g>
      <g class="acc acc-headphones">
        <path d="M53 25 Q51 6 63 6 Q75 6 73 22" fill="none" stroke="#1a1a1a" stroke-width="3" />
        <rect x="49" y="24" width="8" height="12" rx="3.5" fill="#1a1a1a" />
      </g>
    </g>

    <g class="arm-front">
      <g class="part upper">
        <line class="s-skin" x1="68" y1="57" x2="68" y2="86" stroke-width="9" />
        <line class="o o-jersey s-jersey" x1="68" y1="56" x2="68" y2="70" stroke-width="12.5" />
        <line class="o o-casual s-tee" x1="68" y1="56" x2="68" y2="70" stroke-width="12.5" />
        <line class="o o-army s-camo" x1="68" y1="56" x2="68" y2="82" stroke-width="12.5" />
        <g class="part fore">
          <line class="s-skin" x1="68" y1="86" x2="68" y2="113" stroke-width="8" />
          <circle class="c-skin" cx="68" cy="116" r="4.6" />
          <line class="finger s-skin" x1="68" y1="117" x2="68" y2="125" stroke-width="3" />
        </g>
      </g>
    </g>
  </g>
</svg>
