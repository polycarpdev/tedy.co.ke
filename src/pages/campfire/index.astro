---
// src/pages/campfire/index.astro
import Base from '../../layouts/Base.astro';
import Candle from '../../components/campfire/Candle';
import MessageForm from '../../components/campfire/MessageForm';
import Wall from '../../components/campfire/Wall';
import '../../styles/campfire.css';
---
<Base title="The Campfire" description="Sit for a while. Light a candle for Tedy. Leave a memory.">
  <div class="cf">
    <header class="cf-head">
      <p class="cf-eyebrow">Stop <b>05</b></p>
      <h1>The Campfire</h1>
      <p class="cf-intro">Sit for a while. Light a candle. Leave a memory.</p>
    </header>
    <div class="cf-grid">
      <aside class="cf-side">
        <Candle client:load />
        <MessageForm client:visible />
      </aside>
      <Wall client:load />
    </div>
  </div>
</Base>
