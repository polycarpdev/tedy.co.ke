---
// src/components/Tedy.astro
import '../styles/tedy.css';
---
<svg class="tedy" data-tedy data-outfit="jersey" data-acc="none" viewBox="0 0 120 216" aria-hidden="true">
  <defs>
    <pattern id="camo" width="24" height="24" patternUnits="userSpaceOnUse">
      <rect width="24" height="24" fill="#6d6248" />
      <path d="M0 4 Q6 0 10 5 T20 6 L18 11 Q10 13 4 10 Z" fill="#4f5d34" />
      <path d="M2 15 Q8 12 12 17 Q8 22 3 20 Z" fill="#5a3f2e" />
      <path d="M14 14 Q20 12 24 16 L23 22 Q17 23 14 19 Z" fill="#3b3428" />
    </pattern>
  </defs>
  <g class="part body">
    <g class="part arm-back">
      <rect class="c-skin" x="44" y="54" width="8" height="46" rx="4" />
      <circle class="c-skin" cx="48" cy="101" r="4.5" />
      <rect class="o o-jersey c-jersey" x="43" y="51" width="10" height="17" rx="4" />
      <rect class="o o-army c-camo" x="43" y="51" width="10" height="21" rx="4" />
      <rect class="o o-casual c-tee" x="43" y="51" width="10" height="15" rx="4" />
    </g>
    <g class="part leg-back">
      <rect class="c-skin" x="48" y="100" width="10" height="106" rx="5" />
      <rect class="o o-jersey c-shorts" x="47" y="98" width="12" height="34" rx="4" />
      <rect class="o o-jersey c-sock" x="48" y="176" width="10" height="28" rx="3" />
      <rect class="o o-jersey c-boot" x="47" y="203" width="19" height="10" rx="3" />
      <rect class="o o-army c-camo" x="47" y="98" width="12" height="96" rx="5" />
      <rect class="o o-army c-boot" x="47" y="188" width="12" height="18" rx="2" />
      <rect class="o o-army c-boot" x="47" y="203" width="19" height="10" rx="3" />
      <rect class="o o-casual c-jeans" x="47" y="98" width="12" height="104" rx="5" />
      <rect class="o o-casual c-sneaker" x="47" y="202" width="20" height="10" rx="4" />
      <rect class="o o-casual c-sole" x="47" y="209" width="20" height="3" rx="1.5" />
      <rect class="o o-casual c-red" x="52" y="205" width="8" height="2" rx="1" />
    </g>
    <g class="part leg-front">
      <rect class="c-skin" x="58" y="100" width="10" height="106" rx="5" />
      <rect class="o o-jersey c-shorts" x="57" y="98" width="12" height="34" rx="4" />
      <rect class="o o-jersey c-sock" x="58" y="176" width="10" height="28" rx="3" />
      <rect class="o o-jersey c-boot" x="57" y="203" width="19" height="10" rx="3" />
      <rect class="o o-army c-camo" x="57" y="98" width="12" height="96" rx="5" />
      <rect class="o o-army c-boot" x="57" y="188" width="12" height="18" rx="2" />
      <rect class="o o-army c-boot" x="57" y="203" width="19" height="10" rx="3" />
      <rect class="o o-casual c-jeans" x="57" y="98" width="12" height="104" rx="5" />
      <rect class="o o-casual c-sneaker" x="57" y="202" width="20" height="10" rx="4" />
      <rect class="o o-casual c-sole" x="57" y="209" width="20" height="3" rx="1.5" />
      <rect class="o o-casual c-red" x="62" y="205" width="8" height="2" rx="1" />
    </g>
    <g class="part torso">
      <rect class="o o-jersey c-jersey" x="44" y="46" width="30" height="60" rx="8" />
      <path class="o o-jersey" d="M54 46 L59 53 L64 46" fill="none" stroke="#fff" stroke-width="2" />
      <text class="o o-jersey" x="59" y="88" text-anchor="middle" font-size="22" font-weight="700" font-family="sans-serif" fill="#fff">6</text>
      <rect class="o o-army c-camo" x="44" y="46" width="30" height="58" rx="7" />
      <rect class="o o-army" x="48" y="58" width="9" height="8" rx="1" fill="rgba(0,0,0,0.2)" />
      <rect class="o o-army" x="61" y="58" width="9" height="8" rx="1" fill="rgba(0,0,0,0.2)" />
      <rect class="o o-army c-boot" x="44" y="100" width="30" height="5" rx="1" />
      <rect class="o o-casual c-tee" x="44" y="46" width="30" height="60" rx="8" />
      <g class="acc acc-camera">
        <path d="M48 50 L70 86" stroke="#1a1a1a" stroke-width="2" fill="none" />
        <rect x="62" y="82" width="15" height="11" rx="2" fill="#1d1d1d" />
        <circle cx="74" cy="87.5" r="3.6" fill="#0c0c0c" stroke="#555" stroke-width="1" />
      </g>
    </g>
    <g class="part head">
      <rect class="c-skin" x="56" y="36" width="8" height="14" />
      <ellipse class="c-skin" cx="60" cy="27" rx="11" ry="13" />
      <ellipse class="c-skin-dark" cx="50.5" cy="28" rx="2.2" ry="3.4" />
      <circle class="c-ink" cx="65.5" cy="25" r="1.4" />
      <path d="M62.5 33.6 Q66.5 32 70.2 33.8" fill="none" stroke="#111" stroke-width="1.7" stroke-linecap="round" />
      <path d="M64 36.8 Q67 37.8 69.4 36.2" fill="none" stroke="#3a2216" stroke-width="1.1" stroke-linecap="round" />
      <g class="o o-army">
        <ellipse class="c-camo" cx="60" cy="20" rx="18" ry="3.6" />
        <path class="c-camo" d="M50 20 Q50.5 9 60.5 9 Q70.5 9 71 20 Z" />
      </g>
      <g class="o o-casual">
        <path class="c-cap" d="M48.5 21 Q49.5 8.5 60.5 8.5 Q71.5 8.5 72 21 Z" />
        <rect class="c-cap-dark" x="67" y="18.5" width="15" height="3.6" rx="1.8" />
      </g>
      <g class="acc acc-headphones">
        <path d="M49 25 Q48 5 61 5 Q74 5 72 25" fill="none" stroke="#1a1a1a" stroke-width="3" />
        <rect x="46" y="22" width="8" height="12" rx="3.5" fill="#1a1a1a" />
      </g>
    </g>
    <g class="part arm-front">
      <rect class="c-skin" x="62" y="54" width="8" height="46" rx="4" />
      <circle class="c-skin" cx="66" cy="101" r="4.5" />
      <rect class="o o-jersey c-jersey" x="61" y="51" width="10" height="17" rx="4" />
      <rect class="o o-army c-camo" x="61" y="51" width="10" height="21" rx="4" />
      <rect class="o o-casual c-tee" x="61" y="51" width="10" height="15" rx="4" />
    </g>
  </g>
</svg>
