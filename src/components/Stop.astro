---
// src/components/Stop.astro
interface Props {
  n: string;
  title: string;
  line: string;
}

const { n, title, line } = Astro.props;
---
<section class="stop">
  <p class="stop-n">Stop <b>{n}</b></p>
  <h1>{title}</h1>
  <p class="stop-line">{line}</p>
  <slot />
</section>

<style>
  .stop {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.25rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 7rem 1.5rem 4rem;
  }
  .stop-n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .stop-n b { color: var(--color-red); font-weight: 500; }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 13vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .stop-line {
    max-width: 36ch;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  @media (min-width: 1024px) {
    .stop { padding: 8rem 2.5rem 5rem; }
    h1 { font-size: 8rem; }
    .stop-line { font-size: 1.375rem; }
  }
  @media (min-width: 1024px) and (min-aspect-ratio: 2/1) {
    h1 { font-size: 6rem; }
  }
</style>
