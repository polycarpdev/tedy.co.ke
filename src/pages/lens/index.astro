---
// src/pages/lens/index.astro
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { getStops, yearText, type Photo as PhotoData, type Stop } from '../../data/content';
import '../../styles/lens.css';

const stops = await getStops();
const photos = stops.flatMap((s) => s.media.map((m) => ({ m, s })));
const byCount = photos.filter((p) => p.m.by_tedy).length;
const chapters = stops.filter((s) => s.media.length > 0);

const srcset = (m: PhotoData) => {
  const long = Math.max(m.width, m.height) || 1;
  const seen = new Set<number>();
  return [480, 960, 1600, 2400]
    .map((s) => ({ s, w: Math.round(m.width * Math.min(1, s / long)) }))
    .filter(({ w }) => (seen.has(w) ? false : (seen.add(w), true)))
    .map(({ s, w }) => `/media/${m.file}/${s}.webp ${w}w`)
    .join(', ');
};
const metaFor = (s: Stop) => [yearText(s), s.title, s.place].filter(Boolean).join(' · ');
---
<Base title="Through the Lens" description="Photos of Tedy, and photos he took.">
  <div class="lens" data-lens>
    <header class="lens-head">
      <p class="lens-eyebrow">Gallery</p>
      <h1>Through the Lens</h1>
      <p class="lens-intro">Photos of him, and photos he took.</p>
    </header>

    {photos.length === 0 ? (
      <p class="lens-empty">Photos will appear here soon.</p>
    ) : (
      <>
        <div class="chips" role="toolbar" aria-label="Filter photos">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">
            All <span>{photos.length}</span>
          </button>
          <button class="chip" type="button" data-filter="of" aria-pressed="false">
            Of him <span>{photos.length - byCount}</span>
          </button>
          {byCount > 0 && (
            <button class="chip" type="button" data-filter="by" aria-pressed="false">
              <Icon name="camera" size="1em" /> By Tedy <span>{byCount}</span>
            </button>
          )}
          {chapters.map((s) => (
            <button class="chip" type="button" data-filter={`stop:${s.slug}`} aria-pressed="false">
              {s.title} <span>{s.media.length}</span>
            </button>
          ))}
        </div>

        <div class="lens-wall">
          {photos.map(({ m, s }, i) => (
            <button
              class="tile"
              type="button"
              data-tile
              data-stop={s.slug}
              data-by={m.by_tedy ? '1' : '0'}
              data-src={`/media/${m.file}/1600.webp`}
              data-srcset={srcset(m)}
              data-w={m.width}
              data-h={m.height}
              data-alt={m.alt || m.caption || s.title}
              data-meta={metaFor(s)}
              data-caption={m.caption}
              aria-label={`Open photo: ${m.caption || s.title}`}
            >
              <Photo photo={m} sizes="(min-width: 1600px) 18vw, (min-width: 1024px) 23vw, (min-width: 640px) 33vw, 50vw" eager={i < 6} />
              <span class="tile-year">{yearText(s)}</span>
              {m.by_tedy && <span class="tile-by" title="Photo by Tedy"><Icon name="camera" size="0.9rem" /></span>}
            </button>
          ))}
        </div>
      </>
    )}

    <dialog class="vf" data-vf aria-label="Photo viewer">
      <div class="vf-stage" data-vf-stage>
        <img class="vf-img" data-vf-img alt="" draggable="false" />
      </div>
      <div class="vf-frame" aria-hidden="true">
        <span class="vf-corner tl"></span>
        <span class="vf-corner tr"></span>
        <span class="vf-corner bl"></span>
        <span class="vf-corner br"></span>
        <span class="vf-focus"></span>
      </div>
      <p class="vf-count" data-vf-count></p>
      <button class="vf-btn vf-close" type="button" data-vf-close aria-label="Close"><Icon name="x" /></button>
      <button class="vf-btn vf-prev" type="button" data-vf-prev aria-label="Previous photo"><Icon name="caret-left" /></button>
      <button class="vf-btn vf-next" type="button" data-vf-next aria-label="Next photo"><Icon name="caret-right" /></button>
      <div class="vf-info">
        <p class="vf-meta" data-vf-meta></p>
        <p class="vf-caption" data-vf-caption></p>
        <p class="vf-by"><Icon name="camera" size="1em" /> Photo by Tedy</p>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import { initLens } from '../../scripts/lens';

  let cleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-lens]');
    if (root) cleanup = initLens(root);
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
