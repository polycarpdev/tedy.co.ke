---
// src/components/Trail.astro
import Tedy from './Tedy.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import TrailChapters from './TrailChapters.astro';
import { getStops, yearText } from '../data/content';
import '../styles/trail.css';

const stops = await getStops();
const last = stops.length - 1;
const pad = (i: number) => String(i + 1).padStart(2, '0');

let seed = 7;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 40 }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 58).toFixed(2),
  r: (rand() * 1.1 + 0.3).toFixed(2),
  d: (rand() * 4).toFixed(2),
}));
const data = JSON.stringify(
  stops.map((s) => ({ slug: s.slug, year: yearText(s), outfit: s.outfit, accessory: s.accessory }))
);
---
<section class="trail" data-trail data-at="start" data-stops={data} style={`--stops:${stops.length}`}>
  <div class="stage" data-stage>
    <svg class="sky" data-sky aria-hidden="true">
      {stars.map((s) => (
        <circle cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} style={`animation-delay:-${s.d}s`} />
      ))}
    </svg>
    <div class="clouds" data-clouds aria-hidden="true">
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <span class="cloud c3"></span>
      <span class="cloud c4"></span>
    </div>
    <div class="sun" aria-hidden="true"></div>
    <div class="moon" aria-hidden="true"></div>
    <div class="ridge ridge-far" data-ridge="0.05" aria-hidden="true"></div>
    <div class="ridge ridge-near" data-ridge="0.14" aria-hidden="true"></div>
    <div class="ground" aria-hidden="true"></div>

    <div class="veil" aria-hidden="true"></div>

    <div class="world" data-world>
      <div class="slide slide-hero" data-slide>
        <div class="hero hero-gate">
          <div class="homeward" data-homeward hidden>
            <p class="hw-k" data-hw-kicker></p>
            <p class="hw-route"><span data-hw-from></span><Icon name="arrow-right" /><span data-hw-to></span></p>
            <p class="hw-time" data-hw-time></p>
          </div>
          <p class="hero-eyebrow">Thadeus Esirom Etyang</p>
          <h1 class="hero-name" aria-label="Tedy">
            {'Tedy'.split('').map((c, i) => <span aria-hidden="true" style={`--i:${i}`}>{c}</span>)}
          </h1>
          <p class="hero-dates">07.07.1999 <span>—</span> 11.11.2026</p>
          <div class="vigil" data-candle>
            <span class="vigil-candle" aria-hidden="true">
              <span class="vigil-glow"></span>
              <span class="vigil-flame"></span>
              <span class="vigil-wick"></span>
              <span class="vigil-wax"></span>
            </span>
            <p class="vigil-count"><b data-candle-count>–</b> candles burning</p>
            <button class="btn vigil-light" type="button" data-candle-btn data-label="Light a candle">
              <span data-candle-label>Light a candle</span>
            </button>
            <div class="vigil-go">
              <button class="btn" type="button" data-begin>Start the journey <Icon name="arrow-right" /></button>
              <a class="link" href="/eulogy/">Read the eulogy</a>
              <p class="vigil-hint">
                <span class="vigil-hand"><Icon name="hand-pointing" /></span>
                <span class="vigil-touch">or swipe up to walk with Tedy</span>
                <span class="vigil-mouse">or scroll to walk with Tedy</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      {stops.map((s, i) => (
        <div class="slide" data-slide>
          <article class="stop">
            <button
              class="stop-photo"
              type="button"
              data-open={s.slug}
              data-ar={s.cover ? (s.cover.width / (s.cover.height || 1)).toFixed(4) : "0.8"}
              aria-label={`Open ${s.title}`}
              style={`--tilt:${i % 2 ? 2 : -2}deg`}
            >
              <span class="print" data-print>
                {s.cover ? (
                  <Photo photo={s.cover} sizes="(min-width: 1024px) 42rem, 92vw" eager={i < 2} />
                ) : (
                  <span class="stop-photo-empty">{yearText(s)}</span>
                )}
              </span>
            </button>
            <div class="stop-text">
              <p class="stop-meta">
                <b>{pad(i)}</b>
                <span>{yearText(s)}</span>
                {s.place && <span>{s.place}</span>}
              </p>
              <h2 class="stop-title">{s.title}</h2>
              <p class="stop-line">{s.line}</p>
              {i === last ? (
                <div class="stop-end">
                  <div class="stream stream-compact" data-stream>
                    <p class="st-head"><span>Memories</span> <b data-stream-count>–</b></p>
                    <ul class="st-list" data-stream-list></ul>
                    <p class="st-empty">Be the first to leave a memory.</p>
                  </div>
                  <div class="stop-actions">
                    <a class="btn" href="/campfire/">Leave a memory</a>
                    <a class="link" href="/eulogy/">Read the eulogy</a>
                  </div>
                </div>
              ) : (
                <div class="stop-actions">
                  <button class="btn" type="button" data-open={s.slug}>
                    Open this chapter <Icon name="arrow-up-right" />
                  </button>
                  {s.slug === "dream" && <a class="link" href="/lens/">His film roll</a>}
                </div>
              )}
            </div>
          </article>
        </div>
      ))}
    </div>

    <button class="nav-arrow nav-prev" type="button" data-step="-1" aria-label="Previous stop">
      <Icon name="caret-left" />
    </button>
    <button class="nav-arrow nav-next" type="button" data-step="1" aria-label="Next stop">
      <Icon name="caret-right" />
    </button>

    <div class="camp" aria-hidden="true">
      <div class="camp-fire">
        <span class="camp-glow"></span>
        <span class="camp-wood w1"></span>
        <span class="camp-wood w2"></span>
        <span class="camp-flame"></span>
        <span class="camp-flame f2"></span>
        <span class="camp-flame f3"></span>
      </div>
      <div class="camp-seat"></div>
    </div>

    <div class="coach" aria-hidden="true">
      <span class="coach-hand"><Icon name="hand-pointing" size="2.4rem" /></span>
      <span class="coach-text coach-touch">Swipe up to walk with Tedy</span>
      <span class="coach-text coach-mouse">Scroll to walk with Tedy</span>
    </div>

    <div class="tedy-wrap" data-tedy-wrap>
      <p class="bubble" data-bubble aria-live="polite"></p>
      <button class="tedy-btn" type="button" data-tedy-btn aria-label="Say hi to Tedy">
        <Tedy />
      </button>
    </div>

    <div class="bar">
      <div class="bar-info">
        <p class="bar-year" data-year>{stops[0] && yearText(stops[0])}</p>
        <p class="bar-count" data-count>01 / {pad(last)}</p>
      </div>
      <nav class="dots" aria-label="Trail stops">
        {stops.map((s, i) => (
          <button class="dot" type="button" data-jump={i} aria-label={`Go to ${s.title}`}></button>
        ))}
      </nav>
    </div>
  </div>

  <TrailChapters stops={stops} />
</section>

<script>
  import { initTrail } from '../scripts/trail';

  let cleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-trail]');
    if (root) cleanup = initTrail(root);
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
