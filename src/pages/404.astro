---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
import Stop from '../components/Stop.astro';
---
<Base title="Off the trail" description="This page doesn't exist.">
  <Stop n="--" title="Off the trail" line="This path doesn't exist, or you're offline. The trail is still here.">
    <a href="/" class="back">Back to the trail</a>
  </Stop>
</Base>

<style>
  .back {
    justify-self: start;
    margin-top: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-red);
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
</style>
