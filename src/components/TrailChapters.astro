---
// src/components/TrailChapters.astro
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Body from './Body.astro';
import { yearText, type Stop } from '../data/content';

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
{stops.map((s, i) => (
  <template data-chapter={s.slug}>
    <article class="chapter">
      {s.media.length > 0 && (
        <div class={`ch-carousel${s.media.length > 1 ? ' has-thumbs' : ''}`}>
          <div class="ch-stage">
            <div class="ch-photos" data-carousel>
              {s.media.map((m) => (
                <figure class="ch-photo">
                  <Photo photo={m} sizes="(min-width: 1024px) 64rem, 100vw" />
                  {(m.caption || m.by_tedy) && (
                    <figcaption>
                      {m.caption && <span>{m.caption}</span>}
                      {m.by_tedy && <span class="by">Photo by Tedy</span>}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
            {s.media.length > 1 && (
              <>
                <p class="ch-counter" data-counter>1 / {s.media.length}</p>
                <button class="ch-nav ch-prev" type="button" data-car-step="-1" aria-label="Previous photo" disabled>
                  <Icon name="caret-left" />
                </button>
                <button class="ch-nav ch-next" type="button" data-car-step="1" aria-label="Next photo">
                  <Icon name="caret-right" />
                </button>
              </>
            )}
          </div>
          {s.media.length > 1 && (
            <div class="ch-thumbs">
              {s.media.map((m, k) => (
                <button class={`ch-thumb${k === 0 ? ' is-on' : ''}`} type="button" data-car-go={k} aria-label={`Photo ${k + 1}`}>
                  <img src={`/media/${m.file}/480.webp`} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>
      )}
      <div class="ch-text">
        <p class="ch-meta">
          <b>{pad(i)}</b>
          <span>{yearText(s)}</span>
          {s.place && <span>{s.place}</span>}
        </p>
        <h2 class="ch-title">{s.title}</h2>
        <p class="ch-line">{s.line}</p>
        <Body text={s.body} />
      </div>
    </article>
  </template>
))}

<dialog class="sheet" data-sheet aria-label="Chapter">
  <div class="sheet-top">
    <button class="sheet-close" type="button" data-resume aria-label="Back to the walk">
      <Icon name="x" />
    </button>
  </div>
  <div class="sheet-body" data-sheet-body></div>
  <div class="sheet-foot">
    <button class="btn" type="button" data-resume><Icon name="play" /> Resume the walk</button>
  </div>
</dialog>
