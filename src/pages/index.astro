---
// src/pages/index.astro
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Tedy</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Thadeus Esirom Etyang</p>
      <h1>Tedy</h1>
      <p class="dates">07.07.1999 <span>—</span> 11.11.2026</p>
      <p class="note">Something is being built for him.</p>
    </main>
  </body>
</html>

<style>
  :root { color-scheme: dark; }
  body {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: #0a0a0a;
    color: #f5f5f5;
    font-family: system-ui, sans-serif;
  }
  main { text-align: center; padding: 2rem; }
  .eyebrow {
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.75rem;
    opacity: 0.6;
  }
  h1 {
    font-size: clamp(4rem, 18vw, 10rem);
    margin: 0.2em 0;
    letter-spacing: -0.04em;
  }
  .dates { font-variant-numeric: tabular-nums; opacity: 0.8; }
  .dates span { color: #da291c; padding: 0 0.5em; }
  .note { margin-top: 3rem; opacity: 0.4; font-size: 0.9rem; }
</style>
