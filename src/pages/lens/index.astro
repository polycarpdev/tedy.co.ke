---
// src/pages/lens/index.astro
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { getStops, yearText, type Photo as PhotoData, type Stop } from '../../data/content';
import '../../styles/lens.css';

const stops = await getStops();
const photos = stops.flatMap((s) => s.media.map((m) => ({ m, s })));
const byCount = photos.filter((p) => p.m.by_tedy).length;
const chapters = stops.filter((s) => s.media.length > 0);
const pad = (i: number) => String(i).padStart(2, '0');
const ratio = (m: PhotoData) => (m.width / (m.height || 1)).toFixed(4);

const srcset = (m: PhotoData) => {
  const long = Math.max(m.width, m.height) || 1;
  const seen = new Set<number>();
  return [480, 960, 1600, 2400]
    .map((s) => ({ s, w: Math.round(m.width * Math.min(1, s / long)) }))
    .filter(({ w }) => (seen.has(w) ? false : (seen.add(w), true)))
    .map(({ s, w }) => `/media/${m.file}/${s}.webp ${w}w`)
    .join(', ');
};
const metaFor = (s: Stop) => [yearText(s), s.title, s.place].filter(Boolean).join(' · ');
const first = photos[0];
---
<Base title="Through the Lens" description="His film roll: photos of Tedy, and photos he took.">
  <div class="roll" data-roll data-view="strip">
    <header class="roll-head">
      <div>
        <p class="roll-eyebrow">His film roll</p>
        <h1>Through the Lens</h1>
      </div>
      {photos.length > 0 && (
        <div class="roll-tools">
          <button class="roll-tool" type="button" data-view-toggle aria-pressed="false">
            <span class="when-off"><Icon name="squares-four" /> <span class="roll-tool-label">Contact sheet</span></span>
            <span class="when-on"><Icon name="film-strip" /> <span class="roll-tool-label">Film roll</span></span>
          </button>
          <button class="roll-tool roll-sound" type="button" data-sound aria-pressed="true" aria-label="Shutter sound">
            <span class="when-off"><Icon name="speaker-slash" /></span>
            <span class="when-on"><Icon name="speaker-high" /></span>
          </button>
        </div>
      )}
    </header>

    {photos.length === 0 ? (
      <p class="roll-empty">Photos will appear here soon.</p>
    ) : (
      <>
        <div class="roll-chips" role="toolbar" aria-label="Choose a roll">
          <button class="roll-chip" type="button" data-filter="all" aria-pressed="true">
            All frames <span>{photos.length}</span>
          </button>
          <button class="roll-chip" type="button" data-filter="of" aria-pressed="false">
            Of him <span>{photos.length - byCount}</span>
          </button>
          {byCount > 0 && (
            <button class="roll-chip" type="button" data-filter="by" aria-pressed="false">
              By Tedy <span>{byCount}</span>
            </button>
          )}
          {chapters.map((s) => (
            <button class="roll-chip" type="button" data-filter={`stop:${s.slug}`} aria-pressed="false">
              {s.title} <span>{s.media.length}</span>
            </button>
          ))}
        </div>

        <section class="film" aria-label="Film strip">
          <div class="strip" data-strip>
            {photos.map(({ m, s }, i) => (
              <figure
                class="frame"
                data-frame
                data-index={i}
                data-stop={s.slug}
                data-by={m.by_tedy ? '1' : '0'}
                data-src={`/media/${m.file}/1600.webp`}
                data-srcset={srcset(m)}
                data-w={m.width}
                data-h={m.height}
                data-alt={m.alt || m.caption || s.title}
                data-meta={metaFor(s)}
                data-caption={m.caption}
                style={`--ar:${ratio(m)}`}
              >
                <span class="frame-edge" aria-hidden="true">TEDY 400</span>
                <button class="frame-shot" type="button" data-shot aria-label={`Frame ${i + 1}: ${m.caption || s.title}`}>
                  <Photo photo={m} sizes="(min-width: 1024px) 60vw, 86vw" eager={i < 3} />
                </button>
                <span class="frame-no" aria-hidden="true">▸ {pad(i + 1)} <span>{pad(i + 1)}A</span></span>
              </figure>
            ))}
          </div>
          <button class="film-btn film-prev" type="button" data-prev aria-label="Previous frame"><Icon name="caret-left" /></button>
          <button class="film-btn film-next" type="button" data-next aria-label="Next frame"><Icon name="caret-right" /></button>
        </section>

        <div class="roll-info" aria-live="polite">
          <p class="ri-count" data-ri-count>01 / {pad(photos.length)}</p>
          <p class="ri-meta" data-ri-meta>{first && metaFor(first.s)}</p>
          <p class="ri-caption" data-ri-caption hidden={!first?.m.caption}>{first?.m.caption}</p>
          <p class="ri-by" data-ri-by hidden={!first?.m.by_tedy}><Icon name="camera" size="1em" /> Photo by Tedy</p>
        </div>

        <div class="contact" data-contact>
          {photos.map(({ m, s }, i) => (
            <button
              class="cs-tile"
              type="button"
              data-cs={i}
              data-stop={s.slug}
              data-by={m.by_tedy ? '1' : '0'}
              style={`--ar:${ratio(m)}`}
              aria-label={`Go to frame ${i + 1}`}
            >
              <Photo photo={m} sizes="(min-width: 1024px) 20vw, 45vw" />
              <span class="cs-no">{pad(i + 1)}</span>
            </button>
          ))}
        </div>
      </>
    )}

    <dialog class="vf" data-vf aria-label="Photo viewer">
      <div class="vf-stage" data-vf-stage>
        <img class="vf-img" data-vf-img alt="" draggable="false" />
      </div>
      <div class="vf-frame" aria-hidden="true">
        <span class="vf-corner tl"></span>
        <span class="vf-corner tr"></span>
        <span class="vf-corner bl"></span>
        <span class="vf-corner br"></span>
        <span class="vf-focus"></span>
      </div>
      <p class="vf-count" data-vf-count></p>
      <button class="vf-btn vf-close" type="button" data-vf-close aria-label="Close"><Icon name="x" /></button>
      <button class="vf-btn vf-prev" type="button" data-vf-prev aria-label="Previous photo"><Icon name="caret-left" /></button>
      <button class="vf-btn vf-next" type="button" data-vf-next aria-label="Next photo"><Icon name="caret-right" /></button>
      <div class="vf-info">
        <p class="vf-meta" data-vf-meta></p>
        <p class="vf-caption" data-vf-caption></p>
        <p class="vf-by"><Icon name="camera" size="1em" /> Photo by Tedy</p>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import { initLens } from '../../scripts/lens';

  let cleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-roll]');
    if (root) cleanup = initLens(root);
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
