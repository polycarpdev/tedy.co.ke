---
// src/pages/eulogy/index.astro
import Base from '../../layouts/Base.astro';
import { getEulogy } from '../../data/content';

const pages = await getEulogy();
const src = (file: string, s: number) => `/media/${file}/${s}.webp`;
const srcset = (p: { file: string; width: number; height: number }) => {
  const long = Math.max(p.width, p.height) || 1;
  return [960, 1600, 2400]
    .map((s) => `${src(p.file, s)} ${Math.round(p.width * Math.min(1, s / long))}w`)
    .join(', ');
};
---
<Base title="Eulogy" description="The eulogy for Thadeus Esirom 'Tedy' Etyang, 1999 to 2026.">
  <div class="eu">
    <header class="eu-head">
      <p class="eu-eyebrow">In memory</p>
      <h1>Eulogy</h1>
      <p class="eu-intro">Thadeus Esirom Etyang · 07.07.1999 — 11.11.2026</p>
    </header>

    {pages.length > 0 ? (
      <div class="eu-pages" data-eulogy>
        {pages.map((p, i) => (
          <img
            src={src(p.file, 1600)}
            srcset={srcset(p)}
            sizes="(min-width: 60rem) 52rem, 100vw"
            width={p.width}
            height={p.height}
            alt={`Eulogy, page ${i + 1} of ${pages.length}`}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
        ))}
      </div>
    ) : (
      <p class="eu-empty">The eulogy will appear here soon.</p>
    )}
  </div>
</Base>

<style>
  .eu { max-width: 90rem; margin-inline: auto; padding: 7rem 0 4rem; }
  .eu-head { display: grid; gap: 0.75rem; margin: 0 1.5rem 2rem; }
  .eu-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 13vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .eu-intro { font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-muted); }
  .eu-pages {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: 0.5rem;
    -webkit-touch-callout: none;
    user-select: none;
  }
  .eu-pages img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.2rem;
    background: #fff;
    box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.35);
    -webkit-user-drag: none;
  }
  .eu-empty { margin: 0 1.5rem; color: var(--color-muted); }
  @media (min-width: 1024px) {
    .eu { padding: 8rem 2.5rem 5rem; }
    .eu-head { margin-inline: 0; text-align: center; justify-items: center; }
    h1 { font-size: 6rem; }
    .eu-pages { gap: 1.5rem; padding-inline: 0; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-eulogy]');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';
    el.addEventListener('contextmenu', (e) => e.preventDefault());
    el.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>
