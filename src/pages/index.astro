---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Tedy"
  description="The life and story of Thadeus Esirom 'Tedy' Etyang, 1999 to 2026. Soldier, No. 6, music maker, photographer, and the friend who brought everyone together."
>
  <section class="hero">
    <p class="eyebrow">Thadeus Esirom Etyang</p>
    <h1>Tedy</h1>
    <p class="dates">07.07.1999 <span>—</span> 11.11.2026</p>
    <a href="/story/" class="begin">
      Begin the trail <Icon name="arrow-right" />
    </a>
  </section>
</Base>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-content: end;
    gap: 1rem;
    max-width: 90rem;
    margin-inline: auto;
    padding: 7rem 1.5rem 3rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(5rem, 30vw, 9rem);
    letter-spacing: -0.06em;
    line-height: 0.85;
  }
  .dates {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .dates span { color: var(--color-red); padding: 0 0.5em; }
  .begin {
    justify-self: start;
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: border-color 0.2s, gap 0.2s;
  }
  .begin:hover { border-color: var(--color-red); gap: 1.1rem; }
  @media (min-width: 1024px) {
    .hero { padding: 8rem 2.5rem 3.5rem; }
    h1 { font-size: 18rem; }
  }
  @media (min-width: 1024px) and (min-aspect-ratio: 2/1) {
    h1 { font-size: 13rem; }
  }
</style>
