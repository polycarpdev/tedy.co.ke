---
// src/components/Trail.astro
import Tedy from './Tedy.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { getStops, yearText } from '../data/content';
import '../styles/trail.css';

const stops = await getStops();
const last = stops.length - 1;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

let seed = 7;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 40 }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 58).toFixed(2),
  r: (rand() * 1.1 + 0.3).toFixed(2),
  d: (rand() * 4).toFixed(2),
}));
const data = JSON.stringify(
  stops.map((s) => ({ slug: s.slug, year: yearText(s), outfit: s.outfit, accessory: s.accessory }))
);
---
<section class="trail" data-trail data-stops={data} style={`--stops:${stops.length}`}>
  <div class="stage" data-stage>
    <svg class="sky" data-sky aria-hidden="true">
      {stars.map((s) => (
        <circle cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} style={`animation-delay:-${s.d}s`} />
      ))}
    </svg>
    <div class="sun" aria-hidden="true"></div>
    <div class="moon" aria-hidden="true"></div>
    <div class="clouds" data-clouds aria-hidden="true">
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <span class="cloud c3"></span>
      <span class="cloud c4"></span>
    </div>
    <div class="ridge ridge-far" data-ridge="0.05" aria-hidden="true"></div>
    <div class="ridge ridge-near" data-ridge="0.12" aria-hidden="true"></div>

    <div class="world" data-world>
      <div class="slide slide-hero" data-slide>
        <div class="hero">
          <p class="hero-eyebrow">Thadeus Esirom Etyang</p>
          <h1 class="hero-name">Tedy</h1>
          <p class="hero-dates">07.07.1999 <span>—</span> 11.11.2026</p>
          <div class="candle" data-candle>
            <span class="candle-art" aria-hidden="true"><span class="candle-flame"></span></span>
            <span class="candle-text">
              <span><b data-candle-count>–</b> candles lit for Tedy</span>
              <button class="candle-btn" type="button" data-candle-btn>Light a candle</button>
            </span>
          </div>
          <div class="hero-actions">
            <button class="btn" type="button" data-begin>Begin the walk <Icon name="arrow-right" /></button>
            <a class="link" href="/eulogy/">Read the eulogy</a>
          </div>
          <p class="hero-hint"><Icon name="arrow-down" /> Scroll or swipe</p>
        </div>
      </div>

      {stops.map((s, i) => (
        <div class="slide" data-slide>
          <article class="stop">
            <button
              class="stop-photo"
              type="button"
              data-open={s.slug}
              aria-label={`Open ${s.title}`}
              style={`--tilt:${i % 2 ? 1.4 : -1.4}deg`}
            >
              {s.cover ? (
                <Photo photo={s.cover} sizes="(min-width: 1024px) 42rem, 92vw" eager={i < 2} />
              ) : (
                <span class="stop-photo-empty">{yearText(s)}</span>
              )}
            </button>
            <div class="stop-text">
              <p class="stop-meta">
                <b>{pad(i)}</b>
                <span>{yearText(s)}</span>
                {s.place && <span>{s.place}</span>}
              </p>
              <h2 class="stop-title">{s.title}</h2>
              <p class="stop-line">{s.line}</p>
              {i === last ? (
                <div class="stop-actions">
                  <div class="candle" data-candle>
                    <span class="candle-art" aria-hidden="true"><span class="candle-flame"></span></span>
                    <span class="candle-text">
                      <span><b data-candle-count>–</b> candles lit. Each one is a star above.</span>
                      <button class="candle-btn" type="button" data-candle-btn>Light a candle</button>
                    </span>
                  </div>
                  <a class="btn" href="/campfire/">Leave a memory</a>
                  <a class="link" href="/eulogy/">Read the eulogy</a>
                </div>
              ) : (
                <div class="stop-actions">
                  <button class="btn" type="button" data-open={s.slug}>
                    Open this chapter <Icon name="arrow-up-right" />
                  </button>
                </div>
              )}
            </div>
          </article>
        </div>
      ))}
    </div>

    <div class="ground" aria-hidden="true"></div>
    <div class="bar">
      <div class="tedy-wrap" data-tedy-wrap>
        <p class="bubble" data-bubble aria-live="polite"></p>
        <button class="tedy-btn" type="button" data-tedy-btn aria-label="Say hi to Tedy">
          <Tedy />
        </button>
      </div>
      <div class="bar-info">
        <p class="bar-year" data-year>{stops[0] && yearText(stops[0])}</p>
        <p class="bar-count" data-count>01 / {pad(last)}</p>
      </div>
      <nav class="dots" aria-label="Trail stops">
        {stops.map((s, i) => (
          <button class="dot" type="button" data-jump={i} aria-label={`Go to ${s.title}`}></button>
        ))}
      </nav>
    </div>
  </div>

  {stops.map((s, i) => (
    <template data-chapter={s.slug}>
      <article class="chapter">
        {s.media.length > 0 && (
          <div class="ch-carousel">
            <div class="ch-photos" data-carousel>
              {s.media.map((m) => (
                <figure class="ch-photo">
                  <Photo photo={m} sizes="(min-width: 1024px) 64rem, 100vw" />
                  {(m.caption || m.by_tedy) && (
                    <figcaption>
                      {m.caption && <span>{m.caption}</span>}
                      {m.by_tedy && <span class="by">Photo by Tedy</span>}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
            {s.media.length > 1 && <p class="ch-counter" data-counter>1 / {s.media.length}</p>}
          </div>
        )}
        <div class="ch-text">
          <p class="ch-meta">
            <b>{pad(i)}</b>
            <span>{yearText(s)}</span>
            {s.place && <span>{s.place}</span>}
          </p>
          <h2 class="ch-title">{s.title}</h2>
          <p class="ch-line">{s.line}</p>
          {paragraphs(s.body).map((p) => <p class="ch-p">{p}</p>)}
        </div>
      </article>
    </template>
  ))}

  <dialog class="sheet" data-sheet aria-label="Chapter">
    <div class="sheet-top">
      <button class="sheet-close" type="button" data-resume aria-label="Back to the walk">
        <Icon name="x" />
      </button>
    </div>
    <div class="sheet-body" data-sheet-body></div>
    <div class="sheet-foot">
      <button class="btn" type="button" data-resume><Icon name="play" /> Resume the walk</button>
    </div>
  </dialog>
</section>

<script>
  import { initTrail } from '../scripts/trail';

  let cleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-trail]');
    if (root) cleanup = initTrail(root);
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
